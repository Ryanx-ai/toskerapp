# Managed Postgres (server only). Use separate Neon branches/databases per environment.
DATABASE_URL=

# Clerk (MS5.1; documented now, not consumed by the application yet).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Ably Development Pub/Sub: server-only, publish + subscribe on tosker:*.
# Enable Revocable tokens. Never use a NEXT_PUBLIC_ variable for this key.
ABLY_API_KEY=

# Dedicated 32-byte hex key for recoverable share invites. Server only.
# Development + canonical founder-review target; isolate before genuine Production.
ROOM_INVITE_ENCRYPTION_KEY=
