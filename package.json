{
  "name": "toskerapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:verify": "dotenv -e .env.local -- node scripts/verify-database.mjs",
    "db:smoke": "NODE_OPTIONS=--conditions=react-server dotenv -e .env.local -- tsx scripts/smoke-database.ts",
    "db:verify-bootstrap": "NODE_OPTIONS=--conditions=react-server dotenv -e .env.local -- tsx scripts/verify-bootstrap.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
